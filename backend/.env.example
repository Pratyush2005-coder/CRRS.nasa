# AGROVERSE AI Backend Environment Configuration
PROJECT_NAME="AGROVERSE AI Backend"
API_V1_STR="/api"
VERSION="0.1.0"
ENVIRONMENT="development"

# NASA POWER API
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/daily/point"
NASA_POWER_TIMEOUT_SECONDS=30.0

# CORS settings (allowed frontend origins)
# Comma-separated list of origins (no spaces needed, but supported)
# Development defaults (can be overridden):
# CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
# Production example (replace with actual domains):
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"

# Database Configuration
# DATABASE_URL="sqlite:///./data/agroverse.db"  # Default SQLite
# DATABASE_URL="postgresql://user:password@localhost:5432/agroverse"  # PostgreSQL example (psycopg2/psycopg)
# Supported PostgreSQL schemes (synchronous drivers only):
#   postgresql://...           - uses psycopg2 or psycopg v3 (auto-detected)
#   postgresql+psycopg2://...  - explicit psycopg2 driver
#   postgresql+psycopg://...   - explicit psycopg v3 driver
# UNSUPPORTED (async drivers require create_async_engine):
#   postgresql+asyncpg://...   - NOT SUPPORTED by synchronous engine
#   postgresql+pg8000://...    - NOT VERIFIED for this application

# Database Connection Pool Settings (PostgreSQL/QueuePool)
# Pool size: number of connections to maintain in the pool
DATABASE_POOL_SIZE=5
# Max overflow: additional connections allowed beyond pool_size
DATABASE_MAX_OVERFLOW=10
# Pool timeout: seconds to wait for a connection from the pool before timing out
DATABASE_POOL_TIMEOUT=30
# Pool recycle: seconds after which a connection is recycled (-1 for no recycling)
DATABASE_POOL_RECYCLE=1800
# Pool pre-ping: enable connection health checks before checkout
DATABASE_POOL_PRE_PING=true

# Database Connection Timeout (driver-specific, passed via connect_args)
# For PostgreSQL with psycopg2/psycopg/asyncpg this sets connect_timeout
# For SQLite this is ignored
DATABASE_CONNECT_TIMEOUT=10

# Echo SQL queries (debugging only - should be False in production)
# PRODUCTION: DATABASE_ECHO=true is REJECTED when ENVIRONMENT=production
DATABASE_ECHO=false

# Database Initialization Retry Settings
# Maximum number of initialization attempts on startup
DATABASE_INIT_MAX_RETRIES=3
# Seconds to wait between retries (linear backoff: retry_backoff * attempt)
DATABASE_INIT_RETRY_BACKOFF=1.0

# Production Schema Initialization Behavior:
# - ENVIRONMENT=development/test: Base.metadata.create_all() runs on startup (creates tables if missing)
# - ENVIRONMENT=production: create_all() is SKIPPED; schema managed by Alembic migrations only
# - Production startup verifies database connectivity but does not modify schema

# Logging Configuration
# When true, include client IP addresses in request logs.
# Default: false (disabled for privacy). Enable only when explicitly needed for debugging/security.
LOG_CLIENT_IP=false

# Authentication Configuration
# SECURITY: SECRET_KEY must be set via environment variable in production.
# No default provided to fail safely if missing in production.
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Auth Artifact Cleanup Configuration
# Retention period for revoked refresh tokens (days) - tokens revoked longer than this are deleted
REVOKED_REFRESH_TOKEN_RETENTION_DAYS=30
# Retention period for used password reset tokens (days) - tokens used longer than this are deleted
USED_RESET_TOKEN_RETENTION_DAYS=30
# Retention period for expired (unused) password reset tokens (days) - tokens expired longer than this are deleted
EXPIRED_RESET_TOKEN_RETENTION_DAYS=7
# Retention period for expired (unrevoked) refresh tokens (days) - tokens expired longer than this are deleted
EXPIRED_UNREVOKED_REFRESH_TOKEN_RETENTION_DAYS=7
# Maximum number of records to delete per batch during cleanup operations
AUTH_CLEANUP_BATCH_SIZE=500

# Account Lockout Configuration
# Maximum failed login attempts allowed per email+IP within the window
LOGIN_ATTEMPT_MAX_ATTEMPTS=5
# Sliding time window in minutes for counting failed attempts
LOGIN_ATTEMPT_WINDOW_MINUTES=15
# Cooldown period in minutes after max attempts reached (lockout duration)
LOGIN_ATTEMPT_COOLDOWN_MINUTES=15

# Development/Debug Configuration
# SECURITY: Must be false in production. Exposes sensitive tokens in logs for debugging only.
LOG_PASSWORD_RESET_TOKENS=false

# Rate Limiting Configuration
# Set to True ONLY when running behind a trusted reverse proxy (nginx, ALB, Cloudflare, etc.)
# that properly sets X-Forwarded-For header. Never enable this when directly exposed.
BEHIND_TRUSTED_PROXY=false

# Redis Configuration for Distributed Rate Limiting
# Redis connection URL (e.g., redis://localhost:6379/0, rediss://user:pass@host:6379/0)
# REDIS_URL="redis://localhost:6379/0"
# Enable Redis-backed distributed rate limiting. When false, uses in-memory fallback.
# REDIS_RATE_LIMITING_ENABLED=false
# Redis connection timeout in seconds
# REDIS_CONNECTION_TIMEOUT=5.0
# Redis socket timeout in seconds
# REDIS_SOCKET_TIMEOUT=5.0
# Redis socket keepalive in seconds (0 = disabled)
# REDIS_SOCKET_KEEPALIVE=0
# Maximum number of Redis connection retries
# REDIS_MAX_RETRIES=3
# Redis retry backoff factor (exponential backoff: base * 2^attempt)
# REDIS_RETRY_BACKOFF=0.1
# Redis health check interval in seconds (0 = disabled)
# REDIS_HEALTH_CHECK_INTERVAL=30
